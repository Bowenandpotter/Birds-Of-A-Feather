    {
      "id": "w-001",
      "type": "words",
      "title": "关于加班和蛋挞",
      "date": "2026-11-09",
      "time": "21:40",
      "feeling": "Tired",
      "turns": [
        {
          "who": "me",
          "text": "今天又要晚点回来，你别等我了。"
        },
